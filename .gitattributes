# 统一换行符：仓库内容以 LF 存储，避免 Windows 上 gofmt/CI 因 CRLF 产生差异。
* text=auto eol=lf

# 明确文本类型（跨平台检出均为 LF）
*.go        text eol=lf
*.mod       text eol=lf
*.sum       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
Makefile    text eol=lf
*.sh        text eol=lf

# 二进制资源不做换行转换
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.zip       binary
*.gz        binary
*.exe       binary
